{
  "name": "pi-goalplus",
  "version": "0.3.0",
  "description": "Persistent, evidence-checked goals for the Pi coding agent",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "https://github.com/awangs1986/pi-goalplus.git",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "docs/spec.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "~1.4.0 || ~1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run test:native && npm run test:native:compat",
    "test:native": "node test/native/run.mjs",
    "test:native:compat": "node test/native/run.mjs 1.4.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "goal"
  ]
}
